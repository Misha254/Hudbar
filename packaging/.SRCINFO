pkgbase = hudbar
	pkgdesc = Панель для niri: бар, меню, лаунчер приложений, окна схем, обоев, VPN, экран входа и блокировки
	pkgver = 0.18.7
	pkgrel = 1
	url = https://github.com/Misha254/Hudbar
	install = hudbar.install
	arch = x86_64
	license = custom
	makedepends = cargo
	makedepends = git
	makedepends = rust
	depends = dbus
	depends = gcc-libs
	depends = libxkbcommon
	depends = pam
	depends = systemd-libs
	optdepends = niri: рабочий стол, для которого панель и написана, и композитор экрана входа
	optdepends = greetd: экран входа hud-greeter-rs
	optdepends = networkmanager: чип сети, Wi-Fi и VPN (nmcli)
	optdepends = bluez-utils: состояние Bluetooth (bluetoothctl)
	optdepends = pipewire: громкость и микрофон (wpctl, pactl)
	optdepends = dunst: уведомления (dunstctl)
	optdepends = python: hud-setting и hud-migrate-settings
	optdepends = matugen: цвета интерфейса из обоев
	optdepends = kitty: терминальные приложения из лаунчера
	optdepends = yazi: окно файлового менеджера (hud-yazibinds)
	optdepends = pacman-contrib: проверка ожидающих обновлений (checkupdates)
	optdepends = flatpak: обновление Flatpak-приложений из меню
	source = hudbar::git+https://github.com/Misha254/Hudbar.git#tag=v0.18.7
	sha256sums = SKIP

pkgname = hudbar
