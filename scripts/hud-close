#!/usr/bin/env bash
# Закрывает открытое окно HUDbar по Super+Q.
#
# Меню, лаунчер, VPN, схемы и обои — слои zwlr_layer_shell, а не обычные окна:
# `close-window` в niri их не видит. Каждое окно держит pid-файл в
# XDG_RUNTIME_DIR, по нему и закрываем. Если ни одно не открыто, Super+Q
# делает то же, что раньше, — закрывает обычное окно.
set -u

runtime="${XDG_RUNTIME_DIR:-/tmp}"
newest=""
newest_time=-1
for name in hudbar-menu.pid hudbar-apps.pid hudbar-vpn.pid hudbar-schemes.pid hudbar-wallpaper.pid; do
    path="$runtime/$name"
    [ -r "$path" ] || continue
    pid="$(cat "$path" 2>/dev/null)" || continue
    [ -n "$pid" ] || continue
    kill -0 "$pid" 2>/dev/null || continue
    # Самое позднее окно и есть верхнее: меню и обои могут быть открыты вместе.
    stamp="$(stat -c %Y "$path" 2>/dev/null || echo 0)"
    if [ "$stamp" -gt "$newest_time" ]; then
        newest_time="$stamp"
        newest="$pid"
    fi
done

if [ -n "$newest" ]; then
    kill "$newest"
else
    niri msg action close-window
fi
