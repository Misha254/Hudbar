#!/usr/bin/env bash
# Обновление системы HUDbar: pacman/AUR, Flatpak и проверка ожидающих
# обновлений. Запускается из меню в отдельном окне kitty.
#
# Использование:
#   hud-update [--dry-run] <all|pacman|aur|flatpak|check>
#
# Скрипт не использует eval и sh -c: все команды собираются массивами и
# запускаются напрямую. Проверка обновлений ничего не меняет, остальные
# режимы идут без интерактивных подтверждений: y/yes вводить не нужно.
set -euo pipefail

usage() {
    # Только builtin'ы: usage должен работать при любом PATH.
    printf '%s\n' 'Использование: hud-update [--dry-run] <all|pacman|aur|flatpak|check>' '' \
        '  all       обновить pacman/AUR и Flatpak' \
        '  pacman    обновить только пакеты pacman' \
        '  aur       обновить только пакеты AUR (paru или yay)' \
        '  flatpak   обновить только Flatpak' \
        '  check     показать ожидающие обновления, ничего не меняя' '' \
        '  --dry-run показать команды, которые были бы выполнены' >&2
    exit 2
}

dry_run=0
if [[ ${1:-} == "--dry-run" ]]; then
    dry_run=1
    shift
fi

# Пауза на любом выходе: окно kitty в противном случае закрылось бы
# мгновенно, и ошибку было бы не прочитать. Код выхода сохраняется,
# для --dry-run и когда stdin не терминал паузы нет.
on_exit() {
    local status=$?
    trap - EXIT
    if ((!dry_run)) && [[ -t 0 ]]; then
        read -r -p "Нажмите Enter, чтобы закрыть окно…" _ || true
    fi
    exit "$status"
}
trap on_exit EXIT

if ((EUID == 0)); then
    printf 'Не запускайте hud-update от root: скрипт сам вызовет sudo там, где нужно.\n' >&2
    exit 1
fi

(( $# == 1 )) || usage
mode=$1
case "$mode" in
    all | pacman | aur | flatpak | check) ;;
    *) usage ;;
esac

have() {
    command -v "$1" >/dev/null 2>&1
}

step() {
    printf '\n== %s ==\n' "$1"
}

fail() {
    printf 'Ошибка на шаге: %s\n' "$1" >&2
    exit 1
}

# Печатает команду одной строкой (для --dry-run).
print_cmd() {
    local first=1
    local arg
    for arg in "$@"; do
        if ((first)); then
            first=0
        else
            printf ' '
        fi
        printf '%s' "$arg"
    done
    printf '\n'
}

# Печатает команду в --dry-run, иначе выполняет её. Аргументы приходят
# массивом: ни eval, ни sh -c здесь нет.
run_cmd() {
    if ((dry_run)); then
        print_cmd "$@"
        return 0
    fi
    "$@"
}

# paru/yay сами вызывают pacman и берут его блокировку, поэтому проверка
# общая для всех шагов, которые обновляют пакеты.
check_pacman_lock() {
    if ((dry_run)); then
        return 0
    fi
    if [[ -e /var/lib/pacman/db.lck ]]; then
        printf 'Обнаружен /var/lib/pacman/db.lck: другой pacman уже работает.\n' >&2
        printf 'Дождитесь его завершения; файл блокировки удалять не нужно.\n' >&2
        exit 1
    fi
}

aur_helper() {
    if have paru; then
        printf 'paru\n'
    elif have yay; then
        printf 'yay\n'
    fi
}

do_pacman() {
    step "Обновление пакетов pacman"
    check_pacman_lock
    run_cmd sudo pacman -Syu --noconfirm || fail "sudo pacman -Syu --noconfirm"
}

do_aur() {
    local helper
    helper=$(aur_helper)
    if [[ -z $helper ]]; then
        printf 'Нужен один из помощников AUR: paru или yay.\n' >&2
        exit 1
    fi
    step "Обновление пакетов AUR через $helper"
    check_pacman_lock
    run_cmd "$helper" -Sua --noconfirm || fail "$helper -Sua --noconfirm"
}

do_flatpak() {
    if ! have flatpak; then
        printf 'Flatpak не установлен: обновлять нечего.\n' >&2
        exit 1
    fi
    step "Обновление Flatpak"
    run_cmd flatpak update -y || fail "flatpak update -y"
}

do_all() {
    local helper
    helper=$(aur_helper)
    if [[ $helper == "paru" || $helper == "yay" ]]; then
        step "Обновление пакетов pacman и AUR через $helper"
        check_pacman_lock
        run_cmd "$helper" -Syu --noconfirm || fail "$helper -Syu --noconfirm"
    else
        do_pacman
    fi
    if have flatpak; then
        do_flatpak
    fi
}

# Запускает команду проверки: объединяет stdout и stderr в OUT, код — в RC.
# Для режима check важно лишь, пуст ли вывод и каков код; не важно,
# из stdout или stderr пришли байты. Ни eval, ни sh -c, ни temp-файлов.
run_capture() {
    OUT=
    RC=0
    OUT=$("$@" 2>&1) || RC=$?
}

do_check() {
    if ((dry_run)); then
        step "Pacman: ожидающие обновления"
        if have checkupdates; then
            print_cmd checkupdates
        else
            printf 'checkupdates не найден. Установите пакет pacman-contrib.\n'
        fi
        step "AUR: ожидающие обновления"
        local helper
        helper=$(aur_helper)
        if [[ $helper == "paru" ]]; then
            print_cmd paru -Qua
        elif [[ $helper == "yay" ]]; then
            print_cmd yay -Qua
        else
            printf 'Нужен один из помощников AUR: paru или yay.\n'
        fi
        step "Flatpak: ожидающие обновления"
        if have flatpak; then
            print_cmd flatpak remote-ls --updates
        else
            printf 'Flatpak не установлен: проверять нечего.\n'
        fi
        return 0
    fi

    step "Pacman: ожидающие обновления"
    if have checkupdates; then
        run_capture checkupdates
        if ((RC == 0)); then
            [[ -n $OUT ]] && printf '%s\n' "$OUT" || printf 'Обновлений pacman нет.\n'
        elif ((RC == 2)); then
            printf 'Обновлений pacman нет.\n'
        else
            printf 'Не удалось проверить обновления pacman.\n' >&2
            [[ -n $OUT ]] && printf '%s\n' "$OUT" >&2
        fi
    else
        printf 'checkupdates не найден. Установите пакет pacman-contrib.\n' >&2
    fi

    step "AUR: ожидающие обновления"
    local helper
    helper=$(aur_helper)
    if [[ $helper == "paru" || $helper == "yay" ]]; then
        run_capture "$helper" -Qua
        if ((RC == 0)); then
            [[ -n $OUT ]] && printf '%s\n' "$OUT" || printf 'Обновлений AUR нет.\n'
        elif ((RC == 1)) && [[ -z $OUT ]]; then
            printf 'Обновлений AUR нет.\n'
        else
            printf 'Не удалось проверить обновления AUR.\n' >&2
            [[ -n $OUT ]] && printf '%s\n' "$OUT" >&2
        fi
    else
        printf 'Нужен один из помощников AUR: paru или yay.\n' >&2
    fi

    step "Flatpak: ожидающие обновления"
    if have flatpak; then
        run_capture flatpak remote-ls --updates
        if ((RC == 0)); then
            [[ -n $OUT ]] && printf '%s\n' "$OUT" || printf 'Обновлений Flatpak нет.\n'
        else
            printf 'Не удалось проверить обновления Flatpak.\n' >&2
            [[ -n $OUT ]] && printf '%s\n' "$OUT" >&2
        fi
    else
        printf 'Flatpak не установлен: проверять нечего.\n' >&2
    fi
}

case "$mode" in
    all) do_all ;;
    pacman) do_pacman ;;
    aur) do_aur ;;
    flatpak) do_flatpak ;;
    check) do_check ;;
esac
