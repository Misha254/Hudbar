#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

home = Path.home()
config = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
state_path = config / "hudbar/settings.json"
legacy_state_path = config / "hud-settings/settings.json"
defaults = {
    "language": "ru",
    "appearance": {"theme": "pixel"},
    "hudbar": {
        "height": 27, "tray": True, "weather": True, "clock": True,
        "recorder": True, "battery": True, "system": True, "webcam": True,
        "audio": True, "network": True, "dnd": True,
    },
    "notifications": {"line_height": 18, "font_size": 13, "position": "top-right"},
}
MODULE_KEYS = [
    "tray", "weather", "webcam", "clock", "recorder", "battery", "system", "audio", "network", "dnd",
]


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        handle.write(text)
        temporary = Path(handle.name)
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def load_state() -> dict:
    try:
        state = json.loads(state_path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        try:
            state = json.loads(legacy_state_path.read_text())
        except (FileNotFoundError, json.JSONDecodeError):
            state = {}
    if "hudbar" not in state:
        state = {"hudbar": state}
    state.setdefault("language", defaults["language"])
    if state["language"] not in {"ru", "en"}:
        state["language"] = defaults["language"]
    order = state.get("module_order", MODULE_KEYS)
    state["module_order"] = [key for key in order if key in MODULE_KEYS]
    state["module_order"] += [key for key in MODULE_KEYS if key not in state["module_order"]]
    try:
        legacy = json.loads(legacy_state_path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        legacy = {}
    for section in ("appearance", "notifications"):
        if section not in state and section in legacy:
            state[section] = legacy[section]
    for section, values in defaults.items():
        current = state.setdefault(section, {})
        if isinstance(current, dict):
            for key, value in values.items():
                current.setdefault(key, value)
    return state


def save_state(state: dict) -> None:
    write_atomic(state_path, json.dumps(state, indent=2) + "\n")


def restart_hudbar() -> None:
    subprocess.run(["pkill", "-TERM", "-x", "hudbar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(30):
        if subprocess.run(["pgrep", "-x", "hudbar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
            break
        time.sleep(0.1)
    binary = Path(os.environ.get("HUD_BAR_BIN", home / ".local/bin/hudbar"))
    subprocess.Popen([str(binary)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def patch_dunst(state: dict) -> None:
    paths = [config / "dunst/dunstrc", config / "matugen/templates/dunst.conf"]
    font_size = str(state["notifications"]["font_size"])
    line_height = str(state["notifications"]["line_height"])
    origin = state["notifications"]["position"]
    for path in paths:
        if not path.exists():
            continue
        lines = path.read_text().splitlines()
        for index, line in enumerate(lines):
            if re.match(r"^\s*font\s*=", line):
                lines[index] = re.sub(r"\s+\d+\s*$", f" {font_size}", line)
            elif re.match(r"^\s*line_height\s*=", line):
                lines[index] = f"line_height = {line_height}"
            elif re.match(r"^\s*origin\s*=", line):
                lines[index] = f"origin = {origin}"
        write_atomic(path, "\n".join(lines) + "\n")
    subprocess.run(["dunstctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: hud-setting <command> [value]", file=sys.stderr)
        return 2
    command = sys.argv[1]
    state = load_state()
    if command == "current":
        print(json.dumps(state, ensure_ascii=False))
        return 0
    if command == "export":
        print(json.dumps(state, indent=2, ensure_ascii=False))
        return 0
    if command == "language" and len(sys.argv) == 3 and sys.argv[2] in {"ru", "en"}:
        state["language"] = sys.argv[2]
        save_state(state)
        return 0
    if command == "module-move" and len(sys.argv) == 4 and sys.argv[2] in {"up", "down"}:
        key = sys.argv[3]
        order = state["module_order"]
        if key not in order:
            return 2
        index = order.index(key)
        target = index + (1 if sys.argv[2] == "down" else -1)
        if 0 <= target < len(order):
            order[index], order[target] = order[target], order[index]
            save_state(state)
            restart_hudbar()
        return 0
    if command == "theme" and len(sys.argv) == 3 and sys.argv[2] in {"pixel", "normal"}:
        subprocess.run([str(home / ".local/bin/hud-theme"), sys.argv[2]], check=True)
        return 0
    if command == "hud-height" and len(sys.argv) == 3:
        state["hudbar"]["height"] = max(24, min(48, int(sys.argv[2])))
        save_state(state)
        restart_hudbar()
        return 0
    if command == "hud-toggle" and len(sys.argv) == 4:
        key = sys.argv[2]
        if key not in defaults["hudbar"] or key == "height":
            return 2
        state["hudbar"][key] = sys.argv[3].lower() in {"1", "true", "yes", "on"}
        save_state(state)
        restart_hudbar()
        return 0
    if command == "notification-line-height" and len(sys.argv) == 3:
        state["notifications"]["line_height"] = max(14, min(28, int(sys.argv[2])))
    elif command == "notification-font-size" and len(sys.argv) == 3:
        state["notifications"]["font_size"] = max(10, min(18, int(sys.argv[2])))
    elif command == "notification-position" and len(sys.argv) == 3 and sys.argv[2] in {"top-left", "top-right", "bottom-left", "bottom-right"}:
        state["notifications"]["position"] = sys.argv[2]
    elif command == "wallpaper-random":
        subprocess.run([str(home / ".local/bin/wall.sh"), "--random"], check=False)
        return 0
    elif command == "wallpaper-manual":
        subprocess.run([str(home / ".local/bin/wall.sh")], check=False)
        return 0
    elif command == "reset":
        # Сброс возвращает заводские значения, но НЕ меняет тему молча:
        # текущая тема остаётся, иначе reset неожиданно ломал бы шрифты.
        current = load_state()
        state = json.loads(json.dumps(defaults))
        theme = current.get("appearance", {}).get("theme")
        if theme in {"pixel", "normal"}:
            state["appearance"]["theme"] = theme
        save_state(state)
        patch_dunst(state)
        return 0
    else:
        print("unknown command or invalid value", file=sys.stderr)
        return 2
    save_state(state)
    patch_dunst(state)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
