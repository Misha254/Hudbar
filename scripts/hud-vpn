#!/usr/bin/env bash
# Запуск окна VPN. Переключением занимается сам бинарник: повторный вызов
# находит живой pid-файл, посылает SIGTERM и выходит. Отдельный поиск окна здесь
# не нужен и невозможен: слой не виден в `niri msg windows`.
set -euo pipefail

# Бинарник ищется так: HUDBAR_BIN_DIR, затем ~/.local/bin, затем PATH —
# пакет ставит его в /usr/bin, и переменную для этого задавать не нужно.
bin="${HUDBAR_BIN_DIR:-$HOME/.local/bin}/hud-vpn-rs"
if [[ ! -x "$bin" ]]; then
    bin="$(command -v hud-vpn-rs || true)"
fi

if [[ ! -x "$bin" ]]; then
    echo "окно VPN не установлено: нет hud-vpn-rs ни в ${HUDBAR_BIN_DIR:-$HOME/.local/bin}, ни в PATH" >&2
    exit 1
fi

exec setsid -f "$bin" "$@"
