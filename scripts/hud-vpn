#!/usr/bin/env bash
# Запуск окна VPN. Переключением занимается сам бинарник: повторный вызов
# находит живой pid-файл, посылает SIGTERM и выходит. Отдельный поиск окна здесь
# не нужен и невозможен: слой не виден в `niri msg windows`.
set -euo pipefail

bin="${HUDBAR_BIN_DIR:-$HOME/.local/bin}/hud-vpn-rs"

if [[ ! -x "$bin" ]]; then
    echo "окно VPN не установлено: нет $bin" >&2
    exit 1
fi

exec setsid -f "$bin" "$@"
