#!/usr/bin/env bash
set -euo pipefail

# Бинарник ищется так: HUDBAR_BIN_DIR, затем ~/.local/bin, затем PATH —
# пакет ставит его в /usr/bin, и переменную для этого задавать не нужно.
bin="${HUDBAR_BIN_DIR:-$HOME/.local/bin}/hud-yazibinds-rs"
if [[ ! -x "$bin" ]]; then
    bin="$(command -v hud-yazibinds-rs || true)"
fi

if [[ ! -x "$bin" ]]; then
    echo "окно Yazi не установлено: нет hud-yazibinds-rs ни в ${HUDBAR_BIN_DIR:-$HOME/.local/bin}, ни в PATH" >&2
    exit 1
fi

find_window_id() {
    niri msg windows 2>/dev/null | python3 -c '
import sys
wid = None
for line in sys.stdin:
    line = line.rstrip()
    if line.startswith("Window ID "):
        wid = line.split()[2].rstrip(":")
    if "Title: \"Yazi\"" in line and wid:
        print(wid)
        break
' || true
}

window_id=$(find_window_id)
if [[ -n "$window_id" ]]; then
    niri msg action close-window --id "$window_id" >/dev/null 2>&1 || true
    exit 0
fi

exec setsid -f "$bin"
