#!/usr/bin/env bash
# Запуск окна выбора обоев HUDbar. Принимает необязательную папку:
# `hud-wallpaper anime`.
#
# Всё остальное делает сам бинарник, включая переключение: повторный вызов
# находит живой pid-файл, посылает SIGTERM и выходит. Отдельный поиск окна
# здесь не нужен и невозможен: слой не виден в `niri msg windows`.
set -euo pipefail

# Бинарник ищется так: HUDBAR_BIN_DIR, затем ~/.local/bin, затем PATH —
# пакет ставит его в /usr/bin, и переменную для этого задавать не нужно.
bin="${HUDBAR_BIN_DIR:-$HOME/.local/bin}/hud-wallpaper-rs"
if [[ ! -x "$bin" ]]; then
    bin="$(command -v hud-wallpaper-rs || true)"
fi

if [[ ! -x "$bin" ]]; then
    echo "окно обоев не установлено: нет hud-wallpaper-rs ни в ${HUDBAR_BIN_DIR:-$HOME/.local/bin}, ни в PATH" >&2
    exit 1
fi

exec setsid -f "$bin" "$@"
