{
  "$schema": "./settings.schema.json",
  "language": "ru",
  "module_order": [
    "tray",
    "weather",
    "webcam",
    "clock",
    "recorder",
    "battery",
    "system",
    "audio",
    "network",
    "dnd"
  ],
  "hudbar": {
    "height": 27,
    "tray": true,
    "weather": true,
    "webcam": true,
    "clock": true,
    "recorder": true,
    "battery": true,
    "system": true,
    "audio": true,
    "network": true,
    "dnd": true,
    "animations": true,
    "animation_speed": 1.0
  },
  "notifications": {
    "font_size": 13,
    "line_height": 18,
    "position": "top-right"
  },
  "osd": {
    "enabled": false,
    "duration_ms": 1600
  },
  "idle": {
    "screen_off_seconds": 900,
    "suspend_seconds": 1200
  },
  "vpn": {
    "controller": "127.0.0.1:9090",
    "timeout_ms": 1500
  }
}
