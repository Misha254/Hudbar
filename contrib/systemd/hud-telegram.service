[Unit]
Description=Telegram bridge for opencode (phone remote control)
Documentation=https://github.com/Misha254/Hudbar
After=network-online.target opencode-serve.service
Wants=network-online.target
BindsTo=opencode-serve.service

[Service]
Type=simple
ExecStart=%h/.local/bin/hud-telegram-rs
Restart=on-failure
RestartSec=5
# Рабочая папка не задана: мост читает конфиг и состояние по абсолютным путям
# в $HOME. Папка сессии приходит из telegram-state.json, а не из cwd.
# Мост ждёт сервер opencode сам (до минуты), поэтому отдельного ожидания здесь нет.

[Install]
WantedBy=default.target
