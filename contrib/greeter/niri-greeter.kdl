// Конфигурация niri для экрана входа hud-greeter-rs.
//
// Это не рабочая сессия: здесь нет панели, биндов и пользовательских окон —
// только композитор, на котором гритер рисует свой полноэкранный слой.
// После успешного входа гритер сам завершает niri
// (`niri msg action quit --skip-confirmation`), и greetd запускает сессию
// пользователя с его собственным конфигом.
//
// Установка: contrib/greeter/install-greeter.sh (только root) кладёт файл в
// /etc/hudbar/greeter-niri.kdl.

// Раскладка — заглушка: без неё композитор не поднимется. Значения
// поправьте под свою клавиатуру; на вход это не влияет, но Caps Lock и
// набор имени должны работать ожидаемо.
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }
}

// Никаких отступов и анимаций: единственное окно — гритер.
layout {
    gaps 0
}

// Без этой строки niri при первом старте показал бы подсказку по горячим
// клавишам поверх экрана входа.
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

// Гритер — единственное, что здесь запускается.
spawn-at-startup "hud-greeter-rs"
