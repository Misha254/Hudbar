{
  "protocol": "omafox",
  "version": 1,
  "action": "theme-set",
  "theme": "matugen",
  "palette": {
    "mode": "dark",
    "accent": "{{colors.primary.default.hex}}",
    "selection": "{{colors.secondary_container.default.hex}}",
    "muted": "{{colors.outline.default.hex}}",
    "background": "{{colors.surface.default.hex}}",
    "dark_background": "{{colors.surface_container_low.default.hex}}",
    "darker_background": "{{colors.surface_container_lowest.default.hex}}",
    "lighter_background": "{{colors.surface_container_high.default.hex}}",
    "foreground": "{{colors.on_surface.default.hex}}",
    "dark_foreground": "{{colors.on_surface_variant.default.hex}}",
    "light_foreground": "{{colors.on_surface.default.hex}}",
    "bright_foreground": "{{colors.on_surface.default.hex}}",
    "red": "{{colors.error.default.hex}}",
    "yellow": "{{colors.tertiary.default.hex}}",
    "orange": "{{colors.tertiary.default.hex}}",
    "green": "{{colors.tertiary.default.hex}}",
    "cyan": "{{colors.primary.default.hex}}",
    "blue": "{{colors.primary.default.hex}}",
    "magenta": "{{colors.secondary.default.hex}}",
    "brown": "{{colors.outline.default.hex}}",
    "bright_red": "{{colors.error.default.hex}}",
    "bright_yellow": "{{colors.tertiary.default.hex}}",
    "bright_green": "{{colors.tertiary.default.hex}}",
    "bright_cyan": "{{colors.primary.default.hex}}",
    "bright_blue": "{{colors.primary.default.hex}}",
    "bright_magenta": "{{colors.secondary.default.hex}}"
  }
}
